{
  "SDKVersion": 1,
  "Author": "Meeting Controls contributors",
  "Name": "Meeting Controls",
  "Description": "Mic, camera, screen share, leave and meeting-timer keys for Zoom and Microsoft Teams (macOS).",
  "Icon": "images/plugin",
  "Version": "1.0.0",
  "CodePath": "plugin/index.js",
  "Category": "Meeting Controls",
  "CategoryIcon": "images/plugin",
  "Software": {
    "MinimumVersion": "3.10.188.226"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "10.15"
    }
  ],
  "Nodejs": {
    "Version": "20"
  },
  "Actions": [
    {
      "UUID": "com.meetingcontrols.mic",
      "Name": "Mic Toggle",
      "Tooltip": "Mute/unmute mic in Zoom or Teams",
      "Icon": "images/mic",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "images/mic",
          "TitleAlignment": "bottom"
        }
      ],
      "SupportedInMultiActions": true
    },
    {
      "UUID": "com.meetingcontrols.cam",
      "Name": "Camera Toggle",
      "Tooltip": "Start/stop video in Zoom or Teams",
      "Icon": "images/cam",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "images/cam",
          "TitleAlignment": "bottom"
        }
      ],
      "SupportedInMultiActions": true
    },
    {
      "UUID": "com.meetingcontrols.share",
      "Name": "Share Screen",
      "Tooltip": "Start/stop screen share in Zoom or Teams",
      "Icon": "images/share",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "images/share",
          "TitleAlignment": "bottom"
        }
      ],
      "SupportedInMultiActions": true
    },
    {
      "UUID": "com.meetingcontrols.leave",
      "Name": "Leave Meeting",
      "Tooltip": "Leave the meeting (press twice to confirm)",
      "Icon": "images/leave",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "images/leave",
          "TitleAlignment": "bottom"
        }
      ],
      "SupportedInMultiActions": true
    },
    {
      "UUID": "com.meetingcontrols.status",
      "Name": "Meeting Status",
      "Tooltip": "Shows whether you are in a meeting and for how long",
      "Icon": "images/status",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "images/status",
          "TitleAlignment": "bottom"
        }
      ],
      "SupportedInMultiActions": false
    }
  ],
  "CodePathMac": "plugin/index.js"
}